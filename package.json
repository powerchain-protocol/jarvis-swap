{
  "name": "jarvis-swap",
  "version": "1.0.0-rc.15",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "node scripts/validate-production-invariants.mjs && node scripts/ci-check.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:source": "node scripts/validate-source.mjs",
    "postinstall": "node scripts/prisma-generate.mjs",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > database/supabase/types.generated.ts",
    "prebuild": "node scripts/prisma-generate.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:ci": "node scripts/ci-check.mjs",
    "toolchain:check": "node scripts/verify-toolchain.mjs",
    "vercel-build": "node scripts/build-production.mjs",
    "install:deps": "node scripts/install-deps.mjs",
    "validate:production": "node scripts/validate-production-invariants.mjs",
    "validate:env:production": "node scripts/validate-env.mjs --production",
    "validate:mainnet-ready": "node scripts/validate-env.mjs --production && node scripts/validate-deployment-profile.mjs --network=mainnet",
    "validate:devnet-ready": "node scripts/validate-env.mjs && node scripts/validate-deployment-profile.mjs --network=devnet",
    "validate:testnet-ready": "node scripts/validate-env.mjs && node scripts/validate-deployment-profile.mjs --network=testnet",
    "validate:profiles": "node scripts/validate-profile-templates.mjs",
    "validate:readiness": "node scripts/validate-readiness-invariants.mjs",
    "validate:lifecycle": "node scripts/validate-lifecycle-invariants.mjs",
    "validate:policy-fingerprint": "node scripts/validate-policy-fingerprint-invariants.mjs"
  },
  "dependencies": {
    "@wallet-standard/app": "^1.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@cetusprotocol/aggregator-sdk": "^1.6.7",
    "@cetusprotocol/sui-clmm-sdk": "^1.4.7",
    "@mysten/sui": "^2.22.1",
    "@mysten/wallet-standard": "^0.21.9",
    "bn.js": "^5.2.2",
    "@prisma/client": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "@supabase/ssr": "^0.12.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "typescript": "^5.9.0",
    "@types/bn.js": "^5.1.6",
    "prisma": "^7.9.1",
    "supabase": "^2.113.0",
    "@types/pg": "^8.15.5"
  }
}
