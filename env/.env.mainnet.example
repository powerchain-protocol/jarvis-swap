NEXT_PUBLIC_REALTIME_WS_URL=
# Canonical application origin. Required when wallet sessions are enabled.
# Production must use HTTPS; this origin is cryptographically bound into wallet challenges/sessions.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUI_NETWORK=mainnet
# RPC cluster profile: mainnet/testnet/devnet/custom. Custom still targets NEXT_PUBLIC_SUI_NETWORK.
NEXT_PUBLIC_SUI_CLUSTER=mainnet
NEXT_PUBLIC_SUI_CUSTOM_RPC_LABEL=
SUI_RPC_URLS=https://fullnode.mainnet.sui.io:443
SUI_RPC_TIMEOUT_MS=8000
SUI_RPC_RETRIES=2
# Quarantine repeatedly failing read endpoints before probing them again.
SUI_RPC_FAILURE_THRESHOLD=3
SUI_RPC_COOLDOWN_MS=15000
# REQUIRED for production: dedicated provider gRPC endpoint.
SUI_GRPC_URL=https://YOUR-PROVIDER-ENDPOINT
# Ordered gRPC read pool. First healthy endpoint is preferred; reads fail over automatically.
SUI_GRPC_URLS=
# Optional dedicated gRPC submission endpoint; falls back to the primary dedicated gRPC endpoint.
SUI_PROTECTED_RPC_URL=
# For NEXT_PUBLIC_SUI_CLUSTER=custom. Never put browser-user supplied URLs here.
SUI_CUSTOM_GRPC_URL=
JARVIS_REQUIRE_DEDICATED_RPC=true
# Should /api/v1/ready require swap execution, or only the application/network services?
JARVIS_READINESS_REQUIRE_SWAP=true
# Emergency operator kill switch. Disables quote/swap preflight/swap execution only; Send/Receive stay available.
JARVIS_SWAP_OPERATIONS_ENABLED=true
# TBA: set the real treasury/service-fee Sui address before enabling production swaps.
# Service fee goes to this wallet; Sui network gas remains a protocol/network charge.
JARVIS_SWAP_SERVICE_FEE_BPS=250
JARVIS_SWAP_FEE_WALLET=
JARVIS_SUI_COIN_TYPE=
CCT_SUI_COIN_TYPE=
# Operator-controlled exact coin types: SYMBOL:0x...::module::TYPE,...
# User-imported tokens never modify this trust list.
TRUSTED_TOKEN_COIN_TYPES=
CETUS_AGGREGATOR_URL=https://api-sui.cetus.zone/router_v3/find_routes
CETUS_POOL_IDS=
JARVIS_QUOTE_TTL_MS=30000
JARVIS_MAX_SLIPPAGE_BPS=1000
JARVIS_MAX_PRICE_IMPACT_BPS=300
PRICE_PROVIDER_ORDER=pyth,birdeye,coinmarketcap,coingecko
PYTH_HERMES_URLS=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_FEED_IDS=
BIRDEYE_API_KEY=
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=
COINGECKO_IDS=SUI:sui,USDC:usd-coin

# rc.5 transaction integrity / execution policy
JARVIS_QUOTE_SIGNING_SECRET=
# Wallet-authenticated HTTP-only session. Use a high-entropy 32+ byte secret.
JARVIS_SESSION_SECRET=
JARVIS_REQUIRE_WALLET_SESSION=true
JARVIS_SESSION_TTL_MS=43200000
JARVIS_SESSION_CHALLENGE_TTL_MS=120000

JARVIS_REQUIRE_SIGNED_QUOTES=true
JARVIS_MIN_QUOTE_VALIDITY_MS=5000
JARVIS_REQUIRE_ONCHAIN_FEE=true
# Published/audited Mainnet Move fee package and shared Config object.
JARVIS_SWAP_PACKAGE_ID=
JARVIS_SWAP_CONFIG_OBJECT_ID=
SUI_TRANSACTION_WAIT_TIMEOUT_MS=60000
# Hard cap accepted by the JARVIS preflight/execution relay (2 SUI default)
JARVIS_MAX_GAS_BUDGET_MIST=2000000000
CETUS_ALLOWED_PROVIDERS=

# DeepBook V3 capability boundary. Keep disabled until audited pool IDs + SDK PTB adapter are configured.
DEEPBOOK_ENABLED=false
DEEPBOOK_POOL_IDS=
PRICE_MAX_STALENESS_MS=60000
PYTH_MAX_CONFIDENCE_BPS=500

# UX / execution safety
SUI_GAS_RESERVE_MIST=20000000
JARVIS_ACTIVITY_MAX_ITEMS=50

# Wallet activity / Cetus position discovery
JARVIS_WALLET_ACTIVITY_LIMIT=25
CETUS_POSITION_OBJECT_TYPE=

# Database / Supabase
DATABASE_URL=
DIRECT_URL=
DATABASE_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Portfolio/data layer
PORTFOLIO_CACHE_TTL_MS=15000
API_RATE_LIMIT_WINDOW_MS=60000
# Per-instance admission control for expensive upstream work.
API_QUOTE_CONCURRENCY=12
API_PORTFOLIO_CONCURRENCY=8
API_PRICE_CONCURRENCY=16
API_REQUEST_QUEUE_LIMIT=32
API_REQUEST_QUEUE_WAIT_MS=2000
UPSTREAM_FAILURE_THRESHOLD=4
UPSTREAM_COOLDOWN_MS=15000
API_IDEMPOTENCY_TTL_MS=86400000
# Reservation window preventing concurrent duplicate transaction submissions
API_IDEMPOTENCY_LOCK_TTL_MS=60000

# Vercel Cron / operational jobs — server only
CRON_SECRET=

# Cetus LP discovery / accounting
CETUS_POSITION_LIMIT=100
CETUS_POOL_CACHE_TTL_MS=15000

CETUS_QUOTE_TIMEOUT_MS=8000

# Deployment lifecycle
JARVIS_MAINTENANCE_MODE=false
JARVIS_READINESS_TIMEOUT_MS=5000
